{
  "manifest_version": 3,
  "name": "Freedium Redirect",
  "version": "1.3",
  "description": "Riapre l'articolo corrente tramite il mirror Freedium.",
  "browser_specific_settings": {
    "gecko": {
      "id": "freedium-redirect@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["activeTab", "tabs", "menus"],
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_title": "Apri con Freedium",
    "default_icon": {
      "48": "icon.svg",
      "96": "icon.svg"
    }
  },
  "background": {
    "scripts": ["background.js"]
  }
}
