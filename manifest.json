{
  "manifest_version": 3,
  "name": "Freedium Redirect",
  "version": "1.0",
  "description": "Riapre la pagina corrente tramite il mirror Freedium.",
  "browser_specific_settings": {
    "gecko": {
      "id": "freedium-redirect@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Apri con Freedium",
    "default_icon": {
      "48": "icon.svg",
      "96": "icon.svg"
    }
  },
  "background": {
    "scripts": ["background.js"]
  }
}
